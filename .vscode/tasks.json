{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Offscreen Test",
            "type": "shell",
            "command": "cd ${workspaceFolder}/JUCE_Offscreen_Test && cmake --build build --config Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Clean and Build Offscreen Test",
            "type": "shell",
            "command": "cd ${workspaceFolder}/JUCE_Offscreen_Test && rm -rf build && mkdir -p build && cd build && cmake -DCMAKE_BUILD_TYPE=Debug .. && cmake --build .",
            "group": "build",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run Offscreen Test (Headless)",
            "type": "shell",
            "command": "cd ${workspaceFolder}/JUCE_Offscreen_Test && ./build/OffscreenTest_artefacts/JUCE\\ Offscreen\\ Test.app/Contents/MacOS/JUCE\\ Offscreen\\ Test",
            "group": "test",
            "presentation": {
                "reveal": "always"
            }
        }
    ]
} 