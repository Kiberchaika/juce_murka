{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Offscreen Test",
            "type": "shell",
            "command": "cd ${workspaceFolder} && cmake --build build --config Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Clean and Build Offscreen Test",
            "type": "shell",
            "command": "cd ${workspaceFolder} && rm -rf build && mkdir -p build && cd build && cmake -DCMAKE_BUILD_TYPE=Debug .. && cmake --build .",
            "group": "build",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        }
    ]
} 